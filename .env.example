# Copie para .env (que está no .gitignore) e preencha. NUNCA publique sua chave.
GROQ_API_KEY=cole_sua_chave_aqui

# Opcional: mostrar logos e fotos da NBA (uso pessoal e local; leia o AVISO_LEGAL.md). Padrão: 0
EXIBIR_IMAGENS_NBA=0

# Opcional: 0 guarda o histórico de conversas só na sessão do navegador (recomendado se publicar o app)
NBA_HISTORICO=1
